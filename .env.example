OPENROUTER_API_KEY=sk-or-v1-your-private-key
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-private-standard-token

# Optional controls
JAMDDMAJ_OPENROUTER_MODEL=openrouter/free
JAMDDMAJ_CHART_VISION_MODELS=openrouter/free,nvidia/nemotron-nano-12b-v2-vl:free
JAMDDMAJ_HOURLY_LIMIT=25
JAMDDMAJ_DAILY_LIMIT=80
JAMDDMAJ_IP_HOURLY_LIMIT=100
JAMDDMAJ_IP_DAILY_LIMIT=250
JAMDDMAJ_GLOBAL_DAILY_LIMIT=1000
JAMDDMAJ_ALLOW_PAID_MODELS=false
JAMDDMAJ_ALLOWED_ORIGINS=https://www.jamddmaj.com,https://jamddmaj.com,https://jamd-dmaj.vercel.app

# Telegram alerts for the hidden Pro Signals mode
TELEGRAM_BOT_TOKEN=123456789:your-bot-token-from-BotFather
TELEGRAM_CHAT_ID=your-private-chat-or-channel-id
JAMDDMAJ_TELEGRAM_DEVICE_ID=copy-this-from-the-Pro-mode-button

# 24/7 server scanner. Use the same random value in Vercel and GitHub Actions.
JAMDDMAJ_CRON_SECRET=generate-a-long-random-secret
JAMDDMAJ_CLIENT_CONNECTOR=false
JAMDDMAJ_CLIENT_FEED_TOKEN=

# Google account linking
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
JAMDDMAJ_ACCOUNT_SECRET=generate-a-different-long-random-secret

# Signed update discovery
JAMDDMAJ_LATEST_VERSION=1.37.50
JAMDDMAJ_APK_URL=https://github.com/JamdDmaj1/JamdDmaj/releases/latest/download/JamdDmaj-AI.apk

# Optional VPS-only Bitget executor. Do not add these to the public app.
# Keep these only inside /opt/jamddmaj-scanner/.env on the VPS.
JAMDDMAJ_BITGET_MODE=off
JAMDDMAJ_LIVE_CONFIRM=leave-empty-until-you-accept-real-risk
JAMDDMAJ_LIVE_ENTRY_ONLY=false
BITGET_API_KEY=your-bitget-api-key
BITGET_API_SECRET=your-bitget-secret-key
BITGET_PASSPHRASE=your-bitget-api-passphrase
BITGET_PRODUCT_TYPE=USDT-FUTURES
BITGET_MARGIN_COIN=USDT
BITGET_MARGIN_MODE=isolated
JAMDDMAJ_MAX_LIVE_OPEN=1
JAMDDMAJ_MAX_LIVE_MARGIN_USD=3
JAMDDMAJ_FIXED_MARGIN_USD=0
JAMDDMAJ_MAX_NEW_ORDERS_PER_RUN=1
JAMDDMAJ_RECENT_OPEN_MINUTES=20
JAMDDMAJ_MIN_LIVE_SCORE=14
JAMDDMAJ_MIN_LIVE_LIQUIDITY_USD=3000000
JAMDDMAJ_ALLOW_MEME_LIVE=false
JAMDDMAJ_MAX_DAILY_LOSS_USD=25
JAMDDMAJ_MAX_DAILY_LOSS_PERCENT=3
JAMDDMAJ_MAX_CONSECUTIVE_LOSSES=1
JAMDDMAJ_MAX_TRADES_PER_DAY=1
JAMDDMAJ_LIVE_RISK_BALANCE_USD=1000
JAMDDMAJ_EXIT_MANAGER=false
JAMDDMAJ_EXIT_PROTECTION_TRIGGER_ROE=10
JAMDDMAJ_EXIT_PROTECTION_LOCK_ROE=2
JAMDDMAJ_EXIT_CLOSE_ON_REVERSAL=true
JAMDDMAJ_STRICT_REGIME_MIN_SCORE=16
JAMDDMAJ_DEFENSIVE_MAX_LEVERAGE=5
JAMDDMAJ_DEFENSIVE_MAX_MARGIN_USD=3
