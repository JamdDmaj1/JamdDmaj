OPENROUTER_API_KEY=sk-or-v1-your-private-key
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-private-standard-token

# Optional controls
JAMDDMAJ_OPENROUTER_MODEL=openrouter/free
JAMDDMAJ_HOURLY_LIMIT=25
JAMDDMAJ_DAILY_LIMIT=80
JAMDDMAJ_IP_HOURLY_LIMIT=100
JAMDDMAJ_IP_DAILY_LIMIT=250
JAMDDMAJ_GLOBAL_DAILY_LIMIT=1000
JAMDDMAJ_ALLOW_PAID_MODELS=false
JAMDDMAJ_ALLOWED_ORIGINS=https://jamd-dmaj.vercel.app

# Telegram alerts for the hidden Pro Signals mode
TELEGRAM_BOT_TOKEN=123456789:your-bot-token-from-BotFather
TELEGRAM_CHAT_ID=your-private-chat-or-channel-id
JAMDDMAJ_TELEGRAM_DEVICE_ID=copy-this-from-the-Pro-mode-button
