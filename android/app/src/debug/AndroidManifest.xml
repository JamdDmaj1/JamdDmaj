<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- Isolated offline diagnostic app: no production activities, bridges or network. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <application tools:node="replace" android:allowBackup="false"
        android:label="JamdDmaj Wallet Lab" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name="com.jamddmaj.ai.wallet.VaultDiagnosticActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
