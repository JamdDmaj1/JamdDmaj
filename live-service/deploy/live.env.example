PORT=8790
JAMDDMAJ_LIVE_DATA_DIR=/var/lib/jamddmaj-live
JAMDDMAJ_LIVE_MASTER_KEY_FILE=/etc/jamddmaj-live/master.key
JAMDDMAJ_LIVE_ALLOWED_ORIGINS=https://www.jamddmaj.com,https://jamddmaj.com,https://localhost,capacitor://localhost
JAMDDMAJ_LIVE_IDENTITY_URL=https://www.jamddmaj.com/api/perps-identity
JAMDDMAJ_LIVE_SIGNAL_URL=https://www.jamddmaj.com/api/pro-cron
JAMDDMAJ_CRON_SECRET=REPLACE_WITH_THE_EXISTING_SCANNER_CRON_SECRET
JAMDDMAJ_LIVE_ENGINE_ENABLED=false
JAMDDMAJ_LIVE_BETA=true
JAMDDMAJ_LIVE_PUBLIC_URL=https://www.jamddmaj.com
