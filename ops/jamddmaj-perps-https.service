[Unit]
Description=JamdDmaj Perps HTTPS transport (no financial execution)
After=network-online.target jamddmaj-perps-controls.service
Wants=network-online.target
Requires=jamddmaj-perps-controls.service

[Service]
Type=notify
DynamicUser=yes
ExecStart=/opt/jamddmaj-perps/https/caddy run --config /etc/jamddmaj-perps/Caddyfile --adapter caddyfile
Environment=XDG_DATA_HOME=/var/lib/jamddmaj-perps-https/data
Environment=XDG_CONFIG_HOME=/var/lib/jamddmaj-perps-https/config
StateDirectory=jamddmaj-perps-https
StateDirectoryMode=0700
WorkingDirectory=/var/lib/jamddmaj-perps-https
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=10s
TimeoutStopSec=15s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
SystemCallArchitectures=native
MemoryMax=192M
TasksMax=64

[Install]
WantedBy=multi-user.target
