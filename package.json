{
  "name": "jamddmaj-ai",
  "version": "1.37.57",
  "private": true,
  "type": "module",
  "description": "JamdDmaj AI mobile application",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "npm run build:web",
    "postinstall": "node scripts/prepare-plugins.mjs",
    "build:web": "node scripts/build-web.mjs",
    "mobile:sync": "npm run build:web && cap sync",
    "android": "npm run mobile:sync && cap open android",
    "ios": "npm run mobile:sync && cap open ios",
    "mainnet:readiness": "node scripts/check-mainnet-readiness.mjs",
    "mainnet:gate": "node scripts/check-mainnet-readiness.mjs --enforce"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.1",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@solana-mobile/wallet-standard-mobile": "^0.5.3",
    "@solana-program/system": "^0.12.2",
    "@solana-program/token-2022": "0.9.0",
    "@solana/kit": "^6.10.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "esbuild": "^0.28.1"
  }
}
