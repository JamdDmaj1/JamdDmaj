{
  "name": "jamddmaj-ai",
  "version": "1.38.11",
  "private": true,
  "type": "module",
  "description": "JamdDmaj AI mobile application",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:ci": "node --test --test-reporter=./scripts/ci-test-reporter.mjs tests/*.test.mjs",
    "build": "npm run build:web",
    "postinstall": "node scripts/prepare-plugins.mjs",
    "build:web": "node scripts/build-web.mjs",
    "mobile:sync": "npm run build:web && cap sync",
    "android": "npm run mobile:sync && cap open android",
    "ios": "npm run mobile:sync && cap open ios",
    "mainnet:readiness": "node scripts/check-mainnet-readiness.mjs",
    "devnet:rehearse-liquidity-attacks": "node scripts/rehearse-devnet-liquidity-attacks.mjs",
    "devnet:rehearse-vesting-attacks": "node scripts/rehearse-devnet-vesting-attacks.mjs",
    "mainnet:gate": "node scripts/check-mainnet-readiness.mjs --enforce"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.1",
    "@capacitor/android": "8.4.3",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "8.4.3",
    "@capacitor/ios": "8.4.3",
    "@noble/curves": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@solana-program/system": "^0.12.2",
    "@solana-program/token-2022": "0.9.0",
    "@solana/kit": "^6.10.0",
    "age-encryption": "0.3.1",
    "bs58": "^6.0.0",
    "firebase": "13.1.0",
    "qrcode": "1.5.4",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "6.2.5"
  }
}
